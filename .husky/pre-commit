# Auto-format staged files with Prettier
echo "🎨 Running Prettier auto-format..."
npm run lint:fix
if [ $? -ne 0 ]; then
  echo "❌ Prettier formatting failed."
  exit 1
fi
echo "✅ Prettier formatting complete!"

# Run version bump script before commit
node scripts/bump-version.js

# If script failed, abort commit
if [ $? -ne 0 ]; then
  echo "❌ Version bump failed or was cancelled"
  exit 1
fi

# Run tests before commit
npm test -- --run --reporter=default
