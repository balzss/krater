#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint check on staged files
echo "🔍 Running lint check..."
npx eslint --max-warnings=0 $(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(js|jsx|ts|tsx)$" | tr '\n' ' ')
if [ $? -ne 0 ]; then
  echo "❌ Lint check failed. Please fix errors before committing."
  exit 1
fi
echo "✅ Lint check passed!"

# Run version bump script before commit
node scripts/bump-version.js

# If script failed, abort commit
if [ $? -ne 0 ]; then
  echo "❌ Version bump failed or was cancelled"
  exit 1
fi

# Run tests before commit
npm test -- --run --reporter=default
