{
  "manifest_version": 3,
  "name": "Save to Krater",
  "version": "2.0",
  "description": "Quickly save releases from RateYourMusic.com to your Krater library.",
  "icons": {
    "16": "images/library-16.png",
    "48": "images/library-48.png",
    "128": "images/library-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://rateyourmusic.com/*",
    "https://cdn.sonemic.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_icon": {
      "16": "images/library-16.png",
      "32": "images/library-32.png"
    },
    "default_title": "Krater settings"
  },
  "content_scripts": [
    {
      "matches": ["https://rateyourmusic.com/release/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "krater@example.com"
    }
  }
}
