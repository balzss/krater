{
  "name": "krater",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "NEXT_OUTPUT_MODE=export next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "version:bump": "node scripts/bump-version.js",
    "version:bump:no-lint": "node scripts/bump-version.js --no-lint",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "prepare": "husky",
    "setup:db": "npx tsx scripts/init-db.ts",
    "setup:admin": "npx tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^12.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@types/better-sqlite3": "^7.6.13",
    "better-auth": "^1.3.27",
    "better-sqlite3": "^12.4.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.484.0",
    "next": "15.2.4",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.6",
    "vanilla-jsoneditor": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "happy-dom": "^19.0.2",
    "husky": "^9.1.7",
    "msw": "^2.11.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "versionBump": {
    "enabled": true,
    "interactive": true,
    "lintBeforeBump": true,
    "autoSkipInCI": true,
    "skipPaths": [
      "README.md",
      "PLAN.md",
      "ROADMAP.md",
      "CLAUDE.md",
      "MASTER_PLAN.md",
      "docs/",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "__tests__/"
    ]
  }
}
